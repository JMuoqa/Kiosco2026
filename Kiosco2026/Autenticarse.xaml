<Window x:Class="Kiosco2026.Autenticarse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026"
        xmlns:controlesPer="clr-namespace:WPFApp_Muestra.ControlesPer"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Opacity="90"
        Background="Transparent"
        Title="Autenticarse" Height="450" Width="800"
        MouseDown="VistaAut_MouseDown">
    <Border CornerRadius="15"
            Background="#F2000015"
            BorderThickness="5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#000010" Offset="0"/>
                <GradientStop Color="#000010" Offset="0.5"/>
                <GradientStop Color="#000025" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Iniciar sessión"
                       Foreground="White"
                       FontSize="14"
                       FontFamily="Roboto flex"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="55,0,0,0"/>
            <Button x:Name="boton_minimizar"
                    Cursor="Hand"
                    BorderThickness="0"
                    Grid.Column="1"
                    Click="boton_minimizar_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#000035"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="1"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="/Imagenes/minimizar.png"
                       Stretch="Uniform"/>
            </Button>
            <Button x:Name="boton_cerrar"
                    Cursor="Hand"
                    BorderThickness="0"
                    Grid.Column="2"
                    Click="boton_cerrar_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#000035"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="20"
                                Height="20"
                                CornerRadius="1"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="/Imagenes/x-button.png"
                       Stretch="Uniform"/>
            </Button>
            <Image Source="/Imagenes/IconoLogoMuoqaHD.png"
                   Width="250"
                   HorizontalAlignment="Left"
                   Grid.Row="1"
                   Opacity="100"
                   Margin="20,0,0,0"/>
            <StackPanel Width="250"
                        Grid.Row="1"
                        Orientation="Vertical"
                        Margin="55,25,0,0">
                <TextBlock Text="Muoqa"
                           Foreground="White"
                           FontFamily="Roboto flex"
                           FontWeight="ExtraBold"
                           TextAlignment="Center"
                           FontSize="40"/>
                <TextBlock Text="Nombre de usuario"
                           Foreground="White"
                           FontFamily="Roboto flex"
                           FontWeight="Normal"
                           TextAlignment="Left"
                           FontSize="14"
                           Margin="0,15,0,0"/>
                <TextBox x:Name="entrada_usuario"
                         Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         FontFamily="Roboto flex"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="14"
                         BorderThickness="0,0,0,2"
                         Margin="0,5,0,0"
                         VerticalAlignment="Center">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused"
                                         Value="True">
                                    <Setter TargetName="border"
                                            Property="BorderBrush"
                                            Value="#ff9500"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <TextBlock Text="Contraseña"
                           Foreground="White"
                           FontFamily="Roboto flex"
                           FontWeight="Normal"
                           TextAlignment="Left"
                           FontSize="14"
                           Margin="0,25,0,0"/>
                <controlesPer:CuadroContrasenaEnlazable
                    Contrasena="{Binding Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,5,0,0"/>
                <TextBlock Text="{Binding MensajeDeErro}"
                           Foreground="#d7596d"
                           FontFamily="Roboto flex"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           TextAlignment="Left"
                           FontSize="14"
                           Margin="0,15,0,0"/>
                <Button x:Name="boton_confirmar"
                        Content="Confirmar"
                        Foreground="#000"
                        Cursor="Hand"
                        FontFamily="Roboto flex"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Grid.Column="1"
                        Command="{Binding IniciarSession}"
                        FontSize="14"
                        Margin="0,20,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="#DECDB3"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F0E4C8"/>
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#CBBF9C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="40"
                                    CornerRadius="20"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>