<Window x:Class="Kiosco2026.Vistas.AgregarCategoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas"
        mc:Ignorable="d"
        Title="AgregarCategoria" Height="150" Width="900"
        MaxWidth="1100" MaxHeight="800">
    <StackPanel Orientation="Vertical">
        <TextBlock Margin="10" FontSize="22" FontWeight="SemiBold" FontFamily="Roboto Flex">Agregar categoria</TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBox Grid.Column="0" x:Name="entrada_categoria_carga" Style="{StaticResource entrada_form}" Text="{Binding NombreCargar}" 
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                <TextBlock Margin="10, 0, 10, 0" FontFamily="Roboto Flex" 
                           FontSize="16" Text="{Binding Mensaje}" Foreground="{Binding ColorMensaje}" ></TextBlock>
            </StackPanel>
            <RadioButton Grid.Column="1"  Style="{StaticResource boton_confirmar}" Command="{Binding CargarCategoria}"
                                 VerticalAlignment="Top">
                <TextBlock Style="{StaticResource texto_botones_uno}" Text="Añadir"/>
            </RadioButton>
        </Grid>
    </StackPanel>
</Window>
