<Window x:Class="Kiosco2026.Vistas.CONFIGURACION.MenuConfiguracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.CONFIGURACION"
        xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MenuConfiguracion" Height="400" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type modelo:ModeloConfBD}">
            <local:ConfBaseDeDatos/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type modelo:ModeloConfDN}">
            <local:ConfDatosNegocio/>
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <modelo:ModeloConfiguracion/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Cursor="Hand" FontFamily="Robot flex" FontSize="14" Header="Base de datos" Command="{Binding MostrarConfBD}"/>
            <MenuItem Cursor="Hand" FontFamily="Robot flex" FontSize="14" Header="Datos del negocio" Command="{Binding MostrarConfDN}"/>
        </Menu>
        <ContentControl Grid.Row="1" Content="{Binding VistaHijaActual}"
                                x:Name="pruebaAncho"/>
    </DockPanel>
</Window>
