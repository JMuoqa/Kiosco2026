<UserControl x:Class="Kiosco2026.Vistas.CONFIGURACION.ConfBaseDeDatos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kiosco2026.Vistas.CONFIGURACION"
             xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
             mc:Ignorable="d" 
             Height="365.24" Width="750" >
    <UserControl.DataContext>
        <modelo:ModeloConfBD/>
    </UserControl.DataContext>
    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical">
            <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                       Margin="10, 10, 10, 0" Text="IP host"/>
            <TextBox Style="{StaticResource entrada_form}" Margin="10, 5, 10, 0" Text="">
            </TextBox>
            <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                       Margin="10, 10, 10, 0" Text="Base de datos"/>
            <TextBox Style="{StaticResource entrada_form}" Margin="10, 5, 10, 0" Text="">
            </TextBox>
            <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                       Margin="10, 10, 10, 0" Text="Usuario"/>
            <TextBox Style="{StaticResource entrada_form}" Margin="10, 5, 10, 0" Text="">
            </TextBox>
            <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                       Margin="10, 10, 10, 0" Text="Contraseña"/>
            <TextBox Style="{StaticResource entrada_form}" Margin="10, 5, 10, 0" Text="">
            </TextBox>
        </StackPanel>
        <Grid Grid.Column="1">
            <StackPanel >
            </StackPanel>
            <RadioButton Style="{StaticResource boton_confirmar}" VerticalAlignment="Bottom"
                         Margin="10, 10, 10, 47">
                <TextBlock Style="{StaticResource texto_botones_uno}">Guardar</TextBlock>
            </RadioButton>
        </Grid>
    </Grid>
</UserControl>
