<Window x:Class="Kiosco2026.Vistas.INFORMACION.InformacionVentasPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.INFORMACION"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Información de la sección punto de venta" Height="550" Width="800">

        <Border
        Margin="15"
        Padding="25"
        Background="White"
        CornerRadius="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <TextBlock
                Grid.Row="0"
                Text="Ventas"
                FontFamily="Roboto Flex"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>

                <!-- INFORMACIÓN -->
                <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                    <TextBlock
                    FontFamily="Roboto Flex"
                    FontSize="15"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    LineHeight="24">

                    <Run
                        Text="Esta sección permite realizar ventas, controlar los productos agregados y registrar el pago correspondiente."
                        FontWeight="SemiBold"/>

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="1. Buscar producto"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Escribí el nombre o código de barras del producto. También podés utilizar un lector de códigos de barras.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="2. Cantidad"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Indicá cuántas unidades del producto querés agregar a la venta.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="3. Productos"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Cantidad de productos diferentes incluidos en la venta.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="4. Unidades"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Cantidad total de unidades incluidas en la venta.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="5. Forma de pago"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Seleccioná el medio utilizado por el cliente para realizar el pago.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="6. Descuento"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Permite aplicar un descuento porcentual sobre el total de la venta.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="7. Finalizar venta"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Guarda la venta, actualiza el stock y registra sus detalles.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="8. Nueva venta"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Limpia la venta actual para comenzar una nueva.

                    </TextBlock>

                </ScrollViewer>

            </Grid>

        </Border>
</Window>
