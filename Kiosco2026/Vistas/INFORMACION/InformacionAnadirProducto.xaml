<Window x:Class="Kiosco2026.Vistas.INFORMACION.InformacionAnadirProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.INFORMACION"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F2"
        Title="InformacionAnadirProducto" Height="450" Width="800">
    <ScrollViewer>

        <Border Margin="20"
            Padding="25"
            Background="White"
            CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                       Text="Añadir producto"
                       FontFamily="Roboto Flex"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1"
                       FontFamily="Roboto Flex"
                       FontSize="16"
                       TextWrapping="Wrap"
                       LineHeight="25">

                <Run FontWeight="Bold">Código de barras:</Run>
                Identifica el producto mediante su código de barras.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Nombre:</Run>
                Nombre con el que se identificará el producto.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Categoría:</Run>
                Permite organizar el producto dentro de una categoría.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Cantidad:</Run>
                Cantidad total de unidades que ingresan en este lote.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Unidad de medida:</Run>
                Indica cómo se mide el producto, por ejemplo unidades o gramos.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Costo total de compra:</Run>
                Importe total que pagaste por la cantidad ingresada en este lote.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Ganancia sobre costo (%):</Run>
                Porcentaje que se aplica sobre el costo unitario para calcular el precio de venta.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Precio de venta por unidad:</Run>
                Se calcula automáticamente a partir del costo y la ganancia indicada.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Proveedor:</Run>
                Permite indicar quién proporcionó la mercadería.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Ingreso:</Run>
                Fecha correspondiente al ingreso del lote.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Vencimiento:</Run>
                Fecha de vencimiento del lote. Por defecto se establece un año después del ingreso.
                </TextBlock>
            </Grid>

        </Border>
    </ScrollViewer>
</Window>
