<Window x:Class="Kiosco2026.Vistas.INFORMACION.InformacionAnadirProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.INFORMACION"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Información de la sección añadir producto" Height="450" Width="800">

        <Border
        Margin="15"
        Padding="25"
        Background="White"
        CornerRadius="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <TextBlock
                Grid.Row="0"
                Text="Añadir producto"
                FontFamily="Roboto Flex"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>

                <!-- INFORMACIÓN -->
                <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                    <TextBlock
                    FontFamily="Roboto Flex"
                    FontSize="15"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    LineHeight="24">

                    <Run
                        Text="Esta sección permite registrar un nuevo producto y crear un lote con la mercadería ingresada."
                        FontWeight="SemiBold"/>

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="1. Código de barras"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Identifica el producto mediante su código de barras.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="2. Nombre"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Nombre con el que se identificará el producto.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="3. Categoría"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Permite organizar el producto dentro de una categoría.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="4. Cantidad"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Cantidad total de unidades que ingresan en este lote.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="5. Unidad de medida"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Indica cómo se mide el producto, por ejemplo unidades o gramos.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="6. Costo total de compra"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Importe total que pagaste por la cantidad ingresada en este lote.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="7. Ganancia sobre costo (%)"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Porcentaje que se aplica sobre el costo unitario para calcular el precio de venta.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="8. Precio de venta por unidad"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Se calcula automáticamente a partir del costo y la ganancia indicada.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="9. Proveedor"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Permite indicar quién proporcionó la mercadería.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="10. Ingreso"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Fecha correspondiente al ingreso del lote.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="11. Vencimiento"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Fecha de vencimiento del lote. Por defecto se establece un año después del ingreso.

                    </TextBlock>

                </ScrollViewer>

            </Grid>

        </Border>
</Window>
