<Window x:Class="Kiosco2026.Vistas.INFORMACION.InformacionAdministrarCategorias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.INFORMACION"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="Información de la sección administrar categorias" Height="496" Width="800">
    <Border
        Margin="15"
        Padding="25"
        Background="White"
        CornerRadius="12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock
                Grid.Row="0"
                Text="Administrar categorías"
                FontFamily="Roboto Flex"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,20"/>

            <!-- INFORMACIÓN -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <TextBlock
                    FontFamily="Roboto Flex"
                    FontSize="15"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    LineHeight="24">

                    <Run
                        Text="Esta sección permite administrar las categorías utilizadas para organizar los productos del sistema."
                        FontWeight="SemiBold"/>

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="1. Buscar categoría"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Utilizá el campo de búsqueda para encontrar una categoría rápidamente.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="2. Seleccionar una categoría"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Hacé clic sobre una categoría de la lista para cargar sus datos y poder modificarlos.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="3. Editar nombre"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Permite modificar el nombre de la categoría seleccionada.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="4. Visibilidad"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Determina si la categoría estará disponible para utilizarse en el sistema.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="5. Guardar cambios"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Guarda las modificaciones realizadas sobre la categoría seleccionada.

                    <LineBreak/>
                    <LineBreak/>

                    <Run
                        Text="6. Agregar nueva categoría"
                        FontWeight="Bold"/>

                    <LineBreak/>

                    Permite crear una nueva categoría para utilizarla al cargar productos.

                </TextBlock>

            </ScrollViewer>

        </Grid>

    </Border>
</Window>
