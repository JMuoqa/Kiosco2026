<Window x:Class="Kiosco2026.Vistas.INFORMACION.InformacionAdministrarCategorias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.INFORMACION"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F2"
        Title="InformacionAdministrarCategorias" Height="496" Width="800">
    <ScrollViewer>

        <Border Margin="20"
            Padding="25"
            Background="White"
            CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                       Text="Administrar categorías"
                       FontFamily="Roboto Flex"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1"
                       FontFamily="Roboto Flex"
                       FontSize="16"
                       TextWrapping="Wrap"
                       LineHeight="25">

                <Run FontWeight="Bold">Buscar categoría:</Run>
                Utilizá el campo de búsqueda para encontrar una categoría rápidamente.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Seleccionar una categoría:</Run>
                Hacé clic sobre una categoría de la lista para cargar sus datos y poder modificarlos.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Editar nombre:</Run>
                Permite modificar el nombre de la categoría seleccionada.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Visibilidad:</Run>
                Determina si la categoría estará disponible para utilizarse en el sistema.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Guardar cambios:</Run>
                Guarda las modificaciones realizadas sobre la categoría seleccionada.

                <LineBreak/><LineBreak/>

                <Run FontWeight="Bold">Agregar nueva categoría:</Run>
                Permite crear una nueva categoría para utilizarla al cargar productos.
                </TextBlock>
            </Grid>

        </Border>
    </ScrollViewer>
</Window>
