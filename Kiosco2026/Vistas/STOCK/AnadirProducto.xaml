<UserControl x:Class="Kiosco2026.Vistas.AnadirProducto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kiosco2026.Vistas"
             xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1190">
    <UserControl.DataContext>
        <modelo:ModeloAnadirProducto/>
    </UserControl.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding ValoresPredeterminados}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewKeyDown">
            <i:InvokeCommandAction Command="{Binding PreviewKeyDownParaCargar}"
                                   PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="10" Margin="30" Background="#FFFFFF">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBox x:Name="entrada_codigo" Style="{StaticResource entrada_form}" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" 
                         Foreground="{Binding ColoresEntradas.Codigo}" ToolTip="Ingresa el código de barras del producto o un identificador único. Las próximas cargas serán más rápidas si utilizas este código." 
                         PreviewTextInput="entradas_PreviewTextInput">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="KeyDown">
                            <i:InvokeCommandAction Command="{Binding ComprobarExistencia}"
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <TextBox x:Name="entrada_nombre" Style="{StaticResource entrada_form}"
                         Text="{Binding Nombre}" Foreground="{Binding ColoresEntradas.Nombre}"
                         ToolTip="Ingresa el nombre del producto. Ejemplo: «Fideos marca 500 g».">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <ComboBox  x:Name="cmb_categorias"
                           PreviewMouseDown="cmb_categorias_PreviewMouseDown"
                           Style="{StaticResource cmb_entrada_form}" 
                           ItemsSource="{Binding ListaCategorias}"
                           SelectedItem="{Binding Categoria}"
                           Foreground="{Binding ColoresEntradas.Categoria}"
                           Cursor="Hand"
                           ToolTip="Si no ves categorías, primero debes agregar una en la sección «Categorías».">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectionChanged}"
                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="Loaded">
                            <i:InvokeCommandAction Command="{Binding GuardarCmb}" 
                                                           CommandParameter="{Binding ElementName=cmb_categorias}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ComboBox.ItemTemplate>
                        <DataTemplate >
                            <TextBlock Text="{Binding Nombre}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="entrada_cantidad" Style="{StaticResource entrada_form}" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" 
                         PreviewTextInput="entradas_PreviewTextInput" Foreground="{Binding ColoresEntradas.Cantidad}"
                             ToolTip="Ingresa la cantidad de unidades que compraste en este lote.">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <ComboBox x:Name="cmb_unidad" Grid.Column="1" PreviewMouseDown="cmb_categorias_PreviewMouseDown"
                        Style="{StaticResource cmb_entrada_form}" SelectedIndex="0" Foreground="{Binding ColoresEntradas.UnidadMedida}"
                        Cursor="Hand" SelectedItem="{Binding ComboBoxItem}"
                        ToolTip="Selecciona la unidad de medida correspondiente al producto o lote.">
                        <ComboBoxItem Foreground="#000000">Unidad de medida*</ComboBoxItem>
                        <ComboBoxItem Foreground="#000000">Uni</ComboBoxItem>
                        <ComboBoxItem Foreground="#000000">g</ComboBoxItem>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectionChangedUnidadMedida}"
                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding GuardarCmbUni}" 
                                                           CommandParameter="{Binding ElementName=cmb_unidad}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </Grid>
                <TextBox x:Name="entrada_compra" Style="{StaticResource entrada_form}" Text="{Binding Compra, UpdateSourceTrigger=PropertyChanged}" 
                         PreviewTextInput="entradas_PreviewTextInput" Foreground="{Binding ColoresEntradas.Compra}"
                         ToolTip="Ingresa el costo total de compra del lote.">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16"><Bold>- Campos obligatorios: </Bold> Todos los campos marcados con un asterisco
                    <LineBreak/> (<Span Foreground="#990000">*</Span>) deben completarse sin excepción.</TextBlock>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16"><Bold>- Fecha de ingreso:</Bold> Se asigna automáticamente la fecha del día
                    <LineBreak/> en curso al momento de la carga.
                </TextBlock>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16"><Bold>- Fecha de vencimiento:</Bold> Por defecto se establece un año posterior
                    <LineBreak/> a la fecha de ingreso.
                </TextBlock>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16"><Bold>- Agregar categorías:</Bold> Para ampliar tu listado, utilizá la opción 
                    <LineBreak/><Span Foreground="#FF265B71" Cursor="Hand" ToolTip="Es la tercera opción del menú izquierdo, dentro de «Stock».">“Categorías”</Span> disponible dentro de la sección “Stock”.
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="entrada_venta"  Style="{StaticResource entrada_form}" Text="{Binding Margen, UpdateSourceTrigger=PropertyChanged}" 
                         PreviewTextInput="entradas_PreviewTextInput" Foreground="{Binding ColoresEntradas.Venta}"
                         ToolTip="Ingresa el margen de ganancia que deseas obtener sobre la compra del lote. Este valor se expresa en porcentaje.">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,36">
                    <TextBlock Style="{StaticResource titulosFormularios}" FontSize="18" VerticalAlignment="Center" Margin="0" Text="Precio de venta por unidad: "
                               ToolTip="Es el precio de venta final del producto."/>
                    <TextBlock Style="{StaticResource titulosFormularios}" FontSize="18" VerticalAlignment="Center" Margin="0" Text="{Binding PrecioVentaEnVivo}"
                               ToolTip="Es el precio de venta final del producto."/>
                </StackPanel>
                <TextBox x:Name="entrada_proveedor" Style="{StaticResource entrada_form}" Text="{Binding Proveedor}" 
                         Foreground="{Binding ColoresEntradas.Proveedor}"
                         ToolTip="Ingresa el proveedor del producto. Este campo es opcional.">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid Margin="10, 9, 10, 10" Height="41">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource titulosFormularios}" Grid.Column="0" VerticalAlignment="Center" >Ingreso*:</TextBlock>
                    <DatePicker Grid.Column="1" BorderThickness="0" FontFamily="Roboto Flex" FontSize="20" 
                                Padding="0" VerticalAlignment="Center" SelectedDate="{Binding Ingreso}"
                                ToolTip="Modifica la fecha de ingreso del lote si es necesario."></DatePicker>
                </Grid>
                <Grid Margin="10, 9, 10, 10" Height="41">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource titulosFormularios}" Grid.Column="0" VerticalAlignment="Center">Vencimiento:</TextBlock>
                    <DatePicker Grid.Column="1" BorderThickness="0" FontFamily="Roboto Flex" FontSize="20" 
                                Padding="0" VerticalAlignment="Center" SelectedDate="{Binding Vencimiento}"
                                ToolTip="Modifica la fecha de vencimiento del lote si es necesario."></DatePicker>
                </Grid>
                <RadioButton Style="{StaticResource boton_confirmar}" Command="{Binding CargarProducto}"
                             CommandParameter="{Binding ElementName=cmb_categorias}" ToolTip="Puedes presionar la tecla «F9» dos veces para ejecutar esta acción.">
                    <TextBlock Style="{StaticResource texto_botones_uno}" Text="Añadir (F9+F9)"/>
                </RadioButton>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16" Text="{Binding Mensaje}" Foreground="{Binding ColorMensaje}" TextWrapping="Wrap" ></TextBlock>
                <TextBlock Margin="10" FontFamily="Roboto Flex" 
                           FontSize="16" Text="{Binding ProductoNuevo}" Foreground="#ff9500" TextWrapping="Wrap" ></TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
