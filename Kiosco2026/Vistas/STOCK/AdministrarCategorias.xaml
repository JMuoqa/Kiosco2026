<UserControl x:Class="Kiosco2026.Vistas.AdministrarCategorias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kiosco2026.Vistas"
             xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1190">
    <UserControl.DataContext>
        <modelo:ModeloAdministrarCategorias/>
    </UserControl.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding BuscarCategorias}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="10" Margin="30" Background="#FFFFFF">
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" FontFamily="Roboto Flex" 
                           VerticalAlignment="Center" Margin="0, 0, 10, 0">Buscar categoria</TextBlock>
                    <TextBox x:Name="entrada_busqueda" Style="{StaticResource entrada_form}" Margin="0, 0, 10, 0" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" Width="250" Foreground="{Binding ColoresProductos.Busuqeda}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="KeyDown">
                                <i:InvokeCommandAction Command="{Binding KeyDownBuscar}" 
                                PassEventArgsToCommand="True"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding SelecionarTextBox}" 
                                CommandParameter="{Binding ElementName=entrada_busqueda}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <!--
                    <RadioButton Grid.Column="1"  Style="{StaticResource boton_buscar}" Height="40" 
                             VerticalAlignment="Center" Margin="0" Width="200" Command="{Binding BuscarCategorias}">
                        <TextBlock Background="Transparent" Foreground="#141414" FontFamily="Roboto Flex"
                         FontSize="18" FontWeight="Medium">Buscar</TextBlock>
                    </RadioButton>-->
                    <RadioButton Grid.Column="1"  Style="{StaticResource boton_buscar}" Height="40" 
                             VerticalAlignment="Center" Margin="5, 0, 0, 0" Width="50" Command="{Binding BuscarCategorias}">
                             <fa:IconImage Icon="ArrowRotateForward" Margin="0" Style="{StaticResource iconos_menu}"/>

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding RestablecerTodo}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                </StackPanel>
                <RadioButton Style="{StaticResource boton_neutral}" Grid.Column="1" Command="{Binding AbrirMAC}"
                             VerticalAlignment="Center" Margin="0" Width="240" HorizontalAlignment="Right">
                    <TextBlock Background="Transparent" Foreground="#FFFFFF" FontFamily="Roboto Flex"
                         FontSize="18" FontWeight="Medium">Agregar nueva categoría</TextBlock>
                </RadioButton>
            </Grid>
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" BorderBrush="#C8C8D0">
                <Grid Margin="4" x:Name="grillaAncho">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SizeChanged">
                            <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                                   CommandParameter="{Binding ElementName=grillaAncho}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                    CommandParameter="{Binding ElementName=grillaAncho}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Border Width="{Binding EColumna_uno}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="ID" Margin="10, 0, 0, 0"/>
                        </Border>
                        <Border Width="{Binding EColumna_dos}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="VISIBLE"/>
                        </Border>
                        <Border Width="{Binding EColumna_tres}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="NOMBRE"/>
                        </Border>
                    </StackPanel>
                    <ListBox Grid.Row="1"
        ItemsSource="{Binding ListaCategorias}"
        BorderThickness="0"
        Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate >
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
        Height="40" Command="{Binding DataContext.LlenarDatos, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding }">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding DataContext.TColumna_uno, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding ID}" Margin="10, 0, 0, 0"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_dos, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Visible}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_tres, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Nombre}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2"  Orientation="Vertical">
                <StackPanel Margin="0, 20, 0, 25" Orientation="Horizontal" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3,0" FontSize="20" FontWeight="SemiBold" FontFamily="Roboto Flex">Categoría seleccionada:</TextBlock>
                        <TextBox Background="Transparent" Foreground="#000000"
                                 FontSize="18" FontWeight="Medium" FontFamily="Roboto Flex"
                                 Margin="10, 0, 0, 0" Text="{Binding CategoriaSeleccionada}" 
                                 BorderThickness="0" IsReadOnly="True" VerticalAlignment="Bottom"></TextBox>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="{Binding SoloLectura}" x:Name="entrada_edicion" 
                             Style="{StaticResource entrada_form}" Margin="3,0" Text="{Binding Edicion}" 
                             Foreground="{Binding ColoresProductos.BusuqedaUno}" Height="40">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <StackPanel VerticalAlignment="Center" Grid.Column="1" Orientation="Horizontal" Height="40">
                        <TextBlock FontSize="20" FontWeight="Medium" Margin="5, 0, 0, 0"
                                VerticalAlignment="Center" FontFamily="Roboto Flex" ToolTip="Indica si la categoría estará disponible para utilizarse en el sistema.">Visibilidad:</TextBlock>
                        <CheckBox VerticalAlignment="Center" ToolTip="Indica si la categoría estará disponible para utilizarse en el sistema." Margin="10, 0, 0, 0" IsChecked="{Binding Visualizacion}"></CheckBox>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"  Style="{StaticResource boton_confirmar}" Margin="3, 10" Command="{Binding EditarCategoria}">
                        <TextBlock Style="{StaticResource texto_botones_uno}" Text="Guardar cambios" />
                    </RadioButton>
                    <RadioButton Grid.Column="1" Style="{StaticResource boton_cancelar}" Margin="3, 10" 
                             Command="{Binding Cancelar}">
                        <TextBlock Style="{StaticResource texto_botones_uno}" Text="Cancelar" />
                    </RadioButton>
                </Grid>
                <TextBlock FontFamily="Roboto Flex" FontSize="16" 
                           Text="{Binding MensajeEdicion}" Foreground="{Binding ColorMensajeEdicion}"></TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
