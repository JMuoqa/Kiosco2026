<Window x:Class="Kiosco2026.Vistas.EditarLoteProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas"
        xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Title="Editar lotes" Height="800" Width="1400">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding ObtenerProductos}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewKeyDown">
            <i:InvokeCommandAction Command="{Binding PreviewKeyDownParaCerrar}"
                                   PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="330"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="15, 0, 15, 5">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                           VerticalAlignment="Center" Text="Lotes" Margin="0, 0, 30, 0"/>
                <TextBlock FontFamily="Roboto Flex" FontWeight="SemiBold" FontSize="18"
                           VerticalAlignment="Center" Text="Ingreso" Margin="0, 0, 10, 0"/>
                <DatePicker Grid.Column="1" BorderThickness="0" FontFamily="Roboto Flex" FontSize="18" 
                                Padding="0" VerticalAlignment="Center" SelectedDate="{Binding BusquedaIngreso}"
                            Margin="0, 0, 10, 0"></DatePicker>
                <RadioButton Grid.Column="1"  Style="{StaticResource boton_buscar}" Height="40" 
                                VerticalAlignment="Center" Margin="10, 0, 0, 0" Width="60" Command="{Binding BuscarProductos}">
                    <fa:IconImage Icon="Search" Margin="0" Style="{StaticResource iconos_menu}"/>
                </RadioButton>
                <RadioButton Grid.Column="1"  Style="{StaticResource boton_buscar}" Height="40" 
                            VerticalAlignment="Center" Margin="5, 0, 0, 0" Width="50" Command="{Binding ObtenerProductos}">
                    <fa:IconImage Icon="ArrowRotateForward" Margin="0" Style="{StaticResource iconos_menu}"/>
                </RadioButton>
            </StackPanel>
            <Border  Grid.Row="1" BorderThickness="0.6" CornerRadius="10" BorderBrush="#C8C8D0">
                <Grid x:Name="grillaAncho">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SizeChanged">
                            <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                               CommandParameter="{Binding ElementName=grillaAncho}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                                   CommandParameter="{Binding ElementName=grillaAncho}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Border Width="{Binding EColumna_uno}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="ID" Margin="10, 0, 0, 0"/>
                        </Border>
                        <Border Width="{Binding EColumna_dos}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="VISIBLE"/>
                        </Border>
                        <Border Width="{Binding EColumna_tres}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="NOMBRE"/>
                        </Border>
                        <Border Width="{Binding EColumna_cuatro}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="COMPRA"/>
                        </Border>
                        <Border Width="{Binding EColumna_cinco}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="VENTA"/>
                        </Border>
                        <Border Width="{Binding EColumna_seis}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="INGRESO"/>
                        </Border>
                        <Border Width="{Binding EColumna_siete}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="VENCIMIENTO"/>
                        </Border>
                        <Border Width="{Binding EColumna_ocho}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                   VerticalAlignment="Center" Text="CANTIDAD"/>
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                            ItemsSource="{Binding ListaProductos}"
                            BorderThickness="0"
                            Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate >
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" 
        HorizontalAlignment="Left" Height="40" Command="{Binding DataContext.CargarDatosLote, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding }">
                                    <StackPanel Orientation="Horizontal" >
                                        <Border Width="{Binding DataContext.TColumna_uno, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                   VerticalAlignment="Center"  Text="{Binding ID}" Margin="10, 0, 0, 0"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_dos, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                   VerticalAlignment="Center"  Text="{Binding Visible}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_tres, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Nombre, Converter={StaticResource TextTrimmer}, ConverterParameter=15}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_cuatro, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Compra}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_cinco, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Venta}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_seis, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding FechaIngresoARG}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_siete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding FechaVencimientoARG}"/>
                                        </Border>
                                        <Border Width="{Binding DataContext.TColumna_ocho, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding Cantidad}"/>
                                                <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                       VerticalAlignment="Center"  Text="{Binding UnidadMedida}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                           VerticalAlignment="Center" Text="Lote seleccionado: #" Margin="15, 0, 0, 0"/>
                <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                           VerticalAlignment="Center" Text="{Binding Producto.ID}" Margin="0"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="40" Margin="0,0,20,0">
                    <TextBox FontFamily="Roboto Flex" FontWeight="Normal" Text="Ver productos ocultos" 
                                     VerticalAlignment="Center" FontSize="16" Margin="0,0,5,0" IsReadOnly="True"/>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding VerProductosOcultos}"></CheckBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="1">
                <TextBox x:Name="entrada_nombre" Style="{StaticResource entrada_form}" Text="{Binding Nombre}" 
                         Foreground="{Binding ColoresEntradas.Nombre}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="entrada_compra" Style="{StaticResource entrada_form}" Text="{Binding Compra}" 
                         Foreground="{Binding ColoresEntradas.Compra}" Grid.Column="0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <TextBox x:Name="entrada_venta" Style="{StaticResource entrada_form}" Text="{Binding Venta}" 
                         Foreground="{Binding ColoresEntradas.Venta}" Grid.Column="1">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </Grid>
                <Grid Margin="10, 9, 10, 10" Height="41">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource titulosFormularios}" Grid.Column="0" VerticalAlignment="Center" >Ingreso:</TextBlock>
                    <DatePicker Grid.Column="1" BorderThickness="0" FontFamily="Roboto Flex" FontSize="20" 
                                Padding="0" VerticalAlignment="Center" SelectedDate="{Binding Ingreso}"></DatePicker>
                </Grid>
                <Grid Margin="10, 9, 10, 10" Height="41">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource titulosFormularios}" Grid.Column="0" VerticalAlignment="Center">Vencimiento:</TextBlock>
                    <DatePicker Grid.Column="1" BorderThickness="0" FontFamily="Roboto Flex" FontSize="20" 
                                Padding="0" VerticalAlignment="Center" SelectedDate="{Binding Vencimiento}"></DatePicker>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
                <TextBox x:Name="entrada_cantidad" Style="{StaticResource entrada_form}" Text="{Binding Cantidad}" 
                         Foreground="{Binding ColoresEntradas.Cantidad}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <RadioButton Style="{StaticResource boton_confirmar}" Command="{Binding EditarLote}">
                    <TextBlock Style="{StaticResource texto_botones_uno}" Text="Editar"/>
                </RadioButton>
                <TextBlock Margin="10, 23, 10, 0" FontFamily="Roboto Flex" 
                           FontSize="16" Text="{Binding Mensaje}" Foreground="{Binding ColorMensaje}" TextWrapping="Wrap" ></TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
