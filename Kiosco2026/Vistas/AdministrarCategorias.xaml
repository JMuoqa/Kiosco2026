<UserControl x:Class="Kiosco2026.Vistas.AdministrarCategorias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kiosco2026.Vistas"
             xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1190">
    <UserControl.DataContext>
        <modelo:ModeloAdministrarCategorias/>
    </UserControl.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding BuscarCategorias}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="10" Margin="30" Background="#FFFFFF">
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" FontFamily="Roboto Flex" 
                           VerticalAlignment="Center" Margin="0, 0, 10, 0">Buscar categoria</TextBlock>
                    <TextBox x:Name="entrada_busqueda" Style="{StaticResource entrada_form}" Margin="0, 0, 10, 0" Text="{Binding Busqueda}" 
                         Height="40" Width="250" Foreground="{Binding ColoresProductos.Busuqeda}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <RadioButton Grid.Column="1"  Style="{StaticResource boton_buscar}" Height="40" 
                             VerticalAlignment="Center" Margin="0" Width="200" Command="{Binding BuscarCategorias}">
                        <TextBlock Background="Transparent" Foreground="#141414" FontFamily="Roboto Flex"
                         FontSize="18" FontWeight="Medium">Buscar</TextBlock>
                    </RadioButton>
                </StackPanel>
                <RadioButton Style="{StaticResource boton_neutral}" Grid.Column="1" Click="RadioButton_Click"
                             VerticalAlignment="Center" Margin="0" Width="240" HorizontalAlignment="Right">
                    <TextBlock Background="Transparent" Foreground="#FFFFFF" FontFamily="Roboto Flex"
                         FontSize="18" FontWeight="Medium">Ver opciones para agregar</TextBlock>
                </RadioButton>
            </Grid>
            <Border Grid.Row="1" BorderThickness="0.6" CornerRadius="10" BorderBrush="#000000">
                <Grid Margin="4">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SizeChanged">
                            <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LayoutUpdated">
                                <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                    CommandParameter="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Border Width="{Binding EColumna_uno}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="ID" Margin="10, 0, 0, 0"/>
                        </Border>
                        <Border Width="{Binding EColumna_dos}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="VISIBILIDAD"/>
                        </Border>
                        <Border Width="{Binding EColumna_tres}">
                            <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="NOMBRE"/>
                        </Border>
                    </StackPanel>
                    <ScrollViewer  Grid.Row="1" VerticalScrollBarVisibility="Auto" >
                        <ItemsControl  ItemsSource="{Binding ListaCategorias}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                                            Height="40" Command="{Binding DataContext.LlenarDatos, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding }">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="{Binding DataContext.TColumna_uno, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding ID}" Margin="10, 0, 0, 0"/>
                                            </Border>
                                            <Border Width="{Binding DataContext.TColumna_dos, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Mostrar}"/>
                                            </Border>
                                            <Border Width="{Binding DataContext.TColumna_tres, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Nombre}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2"  Orientation="Vertical">
                <StackPanel Margin="0, 20, 0, 10" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  FontSize="22" FontWeight="SemiBold" FontFamily="Roboto Flex">Editar categoria Nº:</TextBlock>
                        <TextBox Background="Transparent" Foreground="#000000"
                                 FontSize="20" FontWeight="Medium" FontFamily="Roboto Flex"
                                 Margin="10, 0, 0, 0" Text="{Binding CategoriaSeleccionada}" 
                                 BorderThickness="0" IsReadOnly="True" VerticalAlignment="Bottom"></TextBox>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="{Binding SoloLectura}" x:Name="entrada_edicion" 
                             Style="{StaticResource entrada_form}" Margin="0" Text="{Binding Edicion}" 
                             Foreground="{Binding ColoresProductos.BusuqedaUno}" Height="40">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding LostFocus}" 
                               CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <StackPanel VerticalAlignment="Center" Grid.Column="1" Orientation="Horizontal" Height="40">
                        <TextBlock FontSize="20" FontWeight="Medium" Margin="5, 0, 0, 0"
                                VerticalAlignment="Center" FontFamily="Roboto Flex">Visibilidad:</TextBlock>
                        <CheckBox VerticalAlignment="Center"  Margin="10, 0, 0, 0" IsChecked="{Binding Visualizacion}"></CheckBox>
                    </StackPanel>
                </Grid>
                <RadioButton Grid.Column="1"  Style="{StaticResource boton_confirmar}" Margin="0, 10" Command="{Binding EditarCategoria}">
                    <TextBlock Style="{StaticResource texto_botones_uno}" Text="Realizar cambios" />
                </RadioButton>
                <RadioButton Grid.Column="1"  Style="{StaticResource boton_cancelar}" Margin="0, 10" >
                    <TextBlock Style="{StaticResource texto_botones_uno}" Text="Cancelar" />
                </RadioButton>
                <TextBlock FontFamily="Roboto Flex" FontSize="16" 
                           Text="{Binding MensajeEdicion}" Foreground="{Binding ColorMensajeEdicion}"></TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
