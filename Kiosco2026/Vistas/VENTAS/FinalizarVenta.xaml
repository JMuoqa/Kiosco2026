<Window x:Class="Kiosco2026.Vistas.VENTAS.FinalizarVenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026.Vistas.VENTAS"
        xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Ticket" 
        Height="690" Width="450">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarVenta}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewKeyDown">
            <i:InvokeCommandAction Command="{Binding PreviewKeyDownParaCerrarOImprimir}"
                                   PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding NombreTienda}" Style="{StaticResource titulosTicket}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DireccionTienda}" Style="{StaticResource textoInfoTicket}" HorizontalAlignment="Center"/>
            <TextBlock Text="--------------------------------------------------------------------------" Style="{StaticResource textoInfoTicket}"/>
            <TextBlock Text="{Binding TicketDeCompra}" Style="{StaticResource textoBoldInfoTicket}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="--------------------------------------------------------------------------" Style="{StaticResource textoInfoTicket}"/>
            <Grid Margin="14, 0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Text="Fecha: " Style="{StaticResource textoBoldInfoTicket}" />
                    <TextBlock Text="{Binding FechaDiaMesAno}" Style="{StaticResource textoInfoTicket}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="Hora: " Style="{StaticResource textoBoldInfoTicket}" />
                    <TextBlock Text="{Binding HoraMinutoSeg}" Style="{StaticResource textoInfoTicket}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Text="Cajero: " Style="{StaticResource textoBoldInfoTicket}" />
                    <TextBlock Text="{Binding Cajero}" Style="{StaticResource textoInfoTicket}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="Caja: " Style="{StaticResource textoBoldInfoTicket}" />
                    <TextBlock Text="{Binding Caja}" Style="{StaticResource textoInfoTicket}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="--------------------------------------------------------------------------" Style="{StaticResource textoInfoTicket}"/>
            <ListBox Grid.Row="1" Margin="14, 0"
                ItemsSource="{Binding ListadoDeProductos}"
                MaxHeight="80"
                BorderThickness="0"
                Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate >
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Cantidad}" Style="{StaticResource textoInfoTicket}" Margin="0" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding UnidadMedida}" Style="{StaticResource textoInfoTicket}" Margin="0" HorizontalAlignment="Left"/>
                                <TextBlock Text=" x $" Style="{StaticResource textoInfoTicket}" Margin="0" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Venta}" Style="{StaticResource textoInfoTicket}" Margin="0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Nombre, Converter={StaticResource TextTrimmer}, ConverterParameter=20}" Grid.Column="0" Style="{StaticResource textoInfoTicket}" Margin="0" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="$" Style="{StaticResource textoInfoTicket}" Margin="0" />
                                    <TextBlock Text="{Binding STRSubTotal}" Style="{StaticResource textoInfoTicket}" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="--------------------------------------------------------------------------" Style="{StaticResource textoInfoTicket}"/>
            <StackPanel Margin="14, 0" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="SUBTOTAL: " Style="{StaticResource textoBoldInfoTicket}" />
                <TextBlock Text="{Binding SubTotal}" Style="{StaticResource textoInfoTicket}" />
            </StackPanel>
            <StackPanel Margin="14, 0" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="DESCUENTO: " Style="{StaticResource textoBoldInfoTicket}" />
                <TextBlock Text="{Binding Descuento}" Style="{StaticResource textoInfoTicket}" />
            </StackPanel>
            <StackPanel Margin="14, 0" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="TOTAL: " Style="{StaticResource textoBoldInfoTicket}" />
                <TextBlock Text="{Binding Total}" Style="{StaticResource textoInfoTicket}" />
            </StackPanel>
            <TextBlock Text="--------------------------------------------------------------------------" Style="{StaticResource textoInfoTicket}"/>
            <StackPanel Margin="14, 0" HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock Text="FORMA DE PAGO: " Style="{StaticResource textoBoldInfoTicket}" />
                <TextBlock Text="{Binding MetodoDePago}" Style="{StaticResource textoInfoTicket}" />
            </StackPanel>
            <StackPanel Margin="14, 0" HorizontalAlignment="Left" Orientation="Horizontal">
                <TextBlock Text="VUELTO: " Style="{StaticResource textoBoldInfoTicket}" />
                <TextBlock Text="{Binding Vuelto}" Style="{StaticResource textoInfoTicket}" />
            </StackPanel>
            <TextBlock Margin="14, 0, 14, 10" Text="MONTO PAGADO: " HorizontalAlignment="Left" Style="{StaticResource textoBoldInfoTicket}" />
            <TextBox Margin="14, 0, 14, 10" Style="{StaticResource entrada_form}" Foreground="{Binding ColoresEntradas.MontoPagado}" 
                     Text="{Binding MontoPagado, UpdateSourceTrigger=PropertyChanged}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding GotFocus}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding LostFocus}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <RadioButton Margin="14, 0" Style="{StaticResource boton_confirmar}" Command="{Binding ImprimirPagina}">
                <TextBlock Style="{StaticResource texto_botones_uno}">
                    Imprimir ticket (F9+F9)
                </TextBlock>
            </RadioButton>
        </StackPanel>
    </Grid>
</Window>
