<UserControl x:Class="Kiosco2026.Vistas.VENTAS.VentasPrincipal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kiosco2026.Vistas.VENTAS"
             xmlns:modelo="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1190">
    <UserControl.DataContext>
        <modelo:ModeloVentasPrincipales/>
    </UserControl.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding ValoresPredeterminados}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Click">
            <i:InvokeCommandAction Command="{Binding RestablecerValoresConfirmado}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border CornerRadius="10" Margin="30" Background="#FFFFFF">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="entrada_codigo" Style="{StaticResource entrada_form}" Width="250" Margin="0, 10, 5, 10"
                         Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding ColoresEntradas.Codigo}"  
                         PreviewTextInput="entradas_PreviewTextInput" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="KeyDown">
                            <i:InvokeCommandAction Command="{Binding KeyDownCargarItem}" 
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="Loaded">
                            <i:InvokeCommandAction Command="{Binding SelecionarTextBox}" 
                                                   CommandParameter="{Binding ElementName=entrada_codigo}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <RadioButton Style="{StaticResource boton_buscar}" Margin="0, 0, 15, 0"  Width="40"
                             Command="{Binding CargarItem}" Focusable="False">
                    <fa:IconImage Icon="Add" Width="20"/>
                </RadioButton>
                <TextBox x:Name="entrada_cantidad" Style="{StaticResource entrada_form}" Width="100" PreviewTextInput="entradas_PreviewTextInput"
                         Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding ColoresEntradas.Cantidad}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding GotFocus}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding LostFocus}" 
                           CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="KeyDown">
                            <i:InvokeCommandAction Command="{Binding FocusACodigos}" 
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </StackPanel>
            <Border Grid.Column="1" Width="200" HorizontalAlignment="Right">
                <RadioButton x:Name="botonRestablecer" Style="{StaticResource boton_cancelar}"  Margin="25, 0, 15, 0" Command="{Binding RestablecerValores}">
                    <TextBlock Style="{StaticResource texto_botones_uno}" Text="Restablecer" Margin="15, 0" />
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding RestablecerValoresConfirmado}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </RadioButton>
            </Border>
            <Grid Grid.Row="1"  >
                <Border  BorderThickness="0.6" CornerRadius="10" BorderBrush="#000000">
                    <Grid >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SizeChanged">
                                <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LayoutUpdated">
                                    <i:InvokeCommandAction Command="{Binding ActualizarAnchoActual}"                                   
                                                       CommandParameter="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <Border Width="{Binding EColumna_uno}">
                                <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="CODIGO" Margin="10, 0, 0, 0"/>
                            </Border>
                            <Border Width="{Binding EColumna_dos}">
                                <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="NOMBRE" Margin="10, 0, 0, 0"/>
                            </Border>
                            <Border Width="{Binding EColumna_tres}">
                                <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="PRECIO" Margin="10, 0, 0, 0"/>
                            </Border>
                            <Border Width="{Binding EColumna_cuatro}">
                                <TextBlock FontFamily="Roboto Flex" FontWeight="DemiBold" FontSize="18"
                                       VerticalAlignment="Center" Text="CANTIDAD" Margin="10, 0, 0, 0"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer  Grid.Row="1" VerticalScrollBarVisibility="Auto" >
                            <ItemsControl  ItemsSource="{Binding ListaProductos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" 
                                                HorizontalAlignment="Left" Height="40" Command="{Binding DataContext.EliminarItem, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding }">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="{Binding DataContext.TColumna_uno, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Codigo }" Margin="10, 0, 0, 0"/>
                                                </Border>
                                                <Border Width="{Binding DataContext.TColumna_dos, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Nombre }" Margin="10, 0, 0, 0"/>
                                                </Border>
                                                <Border Width="{Binding DataContext.TColumna_tres, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Venta }" Margin="10, 0, 0, 0"/>
                                                </Border>
                                                <Border Width="{Binding DataContext.TColumna_cuatro, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding Cantidad }" Margin="10, 0, 0, 0"/>
                                                        <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" FontSize="18"
                                                           VerticalAlignment="Center"  Text="{Binding UnidadMedida }" Margin="10, 0, 0, 0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="5">
                <StackPanel>
                    <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                           Text="Detalles">
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0">
                        <TextBlock FontFamily="Roboto Flex" FontWeight="SemiBold" FontSize="18"
                           Text="Items: ">
                        </TextBlock>
                        <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" Margin="0, 0, 10, 0" FontSize="18"
                           Text="{Binding CantidadItems}">
                        </TextBlock>
                        <TextBlock FontFamily="Roboto Flex" FontWeight="SemiBold" FontSize="18"
                           Text="Total: ">
                        </TextBlock>
                        <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" Margin="0, 0, 10, 0" FontSize="18"
                           Text="{Binding PrecioTotal}">
                        </TextBlock>
                        <TextBlock FontFamily="Roboto Flex" FontWeight="SemiBold" FontSize="18"
                           Text="Cantidad de productos: ">
                        </TextBlock>
                        <TextBlock FontFamily="Roboto Flex" FontWeight="Normal" Margin="0, 0, 10, 0" FontSize="18"
                           Text="{Binding CantidadProductos}">
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0, 10, 0, 0">
                        <TextBlock FontFamily="Roboto Flex" FontWeight="Bold" FontSize="20"
                           Text="Forma de pago">
                        </TextBlock>
                        <ComboBox  x:Name="cmb_categorias" Margin="0, 5" Width="300"
                                   PreviewMouseDown="cmb_categorias_PreviewMouseDown"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource cmb_entrada_form}"
                                   SelectedIndex="0"
                                   SelectedValue="{Binding FormaDePago}"
                                   SelectedValuePath="Content"
                                   Foreground="{Binding ColoresEntradas.Categoria}"
                                   Cursor="Hand"
                                   Focusable="False">
                            <ComboBoxItem Content="Efectivo" Foreground="#000000"/>
                            <ComboBoxItem Content="Transferencia" Foreground="#000000"/>
                            <ComboBoxItem Content="Debito" Foreground="#000000"/>
                        </ComboBox>
                        <TextBox Style="{StaticResource entrada_form}" Width="300" Margin="0, 10, 0, 10"
                                 Text="{Binding Descuento, UpdateSourceTrigger=PropertyChanged}" 
                                 Foreground="{Binding ColoresEntradas.Descuento}" PreviewTextInput="entradas_PreviewTextInput"
                                 HorizontalAlignment="Left" x:Name="entrada_descuento">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding GotFocus}" 
                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding LostFocus}" 
                                   CommandParameter="{Binding Name, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <RadioButton Style="{StaticResource boton_confirmar}" Margin="0, 5"
                                     Command="{Binding AbrirFinalizarVenta}">
                            <TextBlock Style="{StaticResource texto_botones_uno}">Guardar venta</TextBlock>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
