<Window x:Class="Kiosco2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kiosco2026"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:modeloHijas="clr-namespace:Kiosco2026.ModeloDeLasVistas.Hijas"
        xmlns:vistasStok="clr-namespace:Kiosco2026.Vistas"
        xmlns:vistasVentas="clr-namespace:Kiosco2026.Vistas.VENTAS"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowState="Maximized"
        Title="Muoqa stock" Height="900" Width="1440">
    <Window.Resources>
        <DataTemplate DataType="{x:Type modeloHijas:ModeloAnadirProducto}">
            <vistasStok:AnadirProducto/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type modeloHijas:ModeloEditarProducto}">
            <vistasStok:EditarProductos/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type modeloHijas:ModeloAdministrarCategorias}">
            <vistasStok:AdministrarCategorias/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type modeloHijas:ModeloVentasPrincipales}">
            <vistasVentas:VentasPrincipal/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type modeloHijas:ModeloHistorialVentas}">
            <vistasVentas:HistorialVentas/>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="ContenidoPrincipal" Background="#E9E9E9">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="0, 20, 0 ,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource titulosNav}">VENTAS</TextBlock>
                    <RadioButton Style="{StaticResource botones_nav}" Command="{Binding MostrarVentaPrincipal}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="DollarSign" Style="{StaticResource iconos_menu}"/>
                            <TextBlock Style="{StaticResource texto_botones_nav}">Nueva venta</TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource botones_nav}" Command="{Binding MostrarHistorialVentas}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Edit" Style="{StaticResource iconos_menu}"/>
                            <TextBlock Style="{StaticResource texto_botones_nav}">Buscar ventas</TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Style="{StaticResource titulosNav}">STOCK</TextBlock>
                    <StackPanel x:Name="paneProductos" Orientation="Vertical">
                        <RadioButton Style="{StaticResource botones_nav}" Command="{Binding MostrarVistaAdicionProducto}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Add" Style="{StaticResource iconos_menu}" />
                                <TextBlock Style="{StaticResource texto_botones_nav}">Agregar producto</TextBlock>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource botones_nav}" Command="{Binding MostrarEdicionProducto}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Edit" Style="{StaticResource iconos_menu}"/>
                                <TextBlock Style="{StaticResource texto_botones_nav}">Editar productos</TextBlock>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource botones_nav}" Command="{Binding MostrarAdministrarCategorias}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="LayerGroup" Style="{StaticResource iconos_menu}"/>
                                <TextBlock Style="{StaticResource texto_botones_nav}">Categorías</TextBlock>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="20" Background="#FFFFFF" Margin="30, 0, 15, 0">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="22" FontWeight="Bold" FontFamily="Roboto Flex" VerticalAlignment="Center"
                                       Text="{Binding NombreVentana}"></TextBlock>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="20" Background="#FFFFFF" Margin="15, 0, 30, 0">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="2" Command="{Binding AbrirConfiguracion}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#BEE6FD"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="20">
                                                <ContentPresenter 
                                                    RecognizesAccessKey="True"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <fa:IconImage  Icon="Gear" Width="20"/>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding AbrirVentanaInfo}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#BEE6FD"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="20">
                                                <ContentPresenter 
                                                    RecognizesAccessKey="True"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <fa:IconImage  Icon="InfoCircle" Width="20" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <ContentControl Grid.Row="1" Content="{Binding VistaHijaActual}"
                                x:Name="pruebaAncho"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
