<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="entrada_form" TargetType="TextBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="Roboto Flex"/>
        <Setter Property="Foreground" Value="#202020"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#C8C8D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <Border
                    x:Name="Borde"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                        <ScrollViewer
                        x:Name="PART_ContentHost"
                        Margin="0"
                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Cuando está seleccionado -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                            TargetName="Borde"
                            Property="BorderBrush"
                            Value="#090920"/>
                            <Setter
                            TargetName="Borde"
                            Property="BorderThickness"
                            Value="2"/>
                        </Trigger>
                        <!-- Deshabilitado -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter
                            TargetName="Borde"
                            Property="Opacity"
                            Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="cmb_entrada_form" TargetType="ComboBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="5, 10, 5, 10"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="Roboto Flex"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#B9B9B9"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border CornerRadius="10" BorderBrush="#C8C8D0" BorderThickness="1"  Background="{TemplateBinding Background}">
                            <ContentPresenter
                                Margin="5"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ToggleButton
                            Grid.Column="1"    
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False"
                            ClickMode="Press"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="5"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            BorderThickness="0" Cursor="Hand">
                            <Path Fill="White"  Data="M 0 0 L 4 4 L 8 0 Z" />
                        </ToggleButton>
                        <Popup Name="PART_Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False"
                            PopupAnimation="Slide">
                            <Border Background="#EEEEEE" CornerRadius="5">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="entrada_form_2" TargetType="TextBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="Roboto Flex"/>
        <Setter Property="Background" Value="#090920"/>
        <Setter Property="Padding" Value="5, 10, 5, 10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#B9B9B9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent">
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>